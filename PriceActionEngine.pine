//@version=5
indicator("Perfect Price Action Engine", overlay=true, max_labels_count=200, max_boxes_count=50)

// ============================
// Inputs
// ============================
pivotLeft = input.int(5, "Pivot Left", minval=1, maxval=50)
pivotRight = input.int(5, "Pivot Right", minval=1, maxval=50)
bosLookback = input.int(20, "BOS Lookback", minval=5, maxval=200)
volLookback = input.int(20, "Volume SMA Length", minval=5, maxval=200)
volMultiplier = input.float(1.5, "Volume Bubble Threshold", minval=0.1, step=0.1)
minFvgGap = input.float(0.0, "Min FVG Gap", minval=0.0, step=0.1)

showFVG = input.bool(true, "Show FVG")
showBOS = input.bool(true, "Show BOS")
showCHoCH = input.bool(true, "Show CHoCH")
showHHLL = input.bool(true, "Show HH / LL")
showVol = input.bool(true, "Show Volume")

// ============================
// FVG detection
// ============================
bullFVG = low > math.max(high[1], high[2]) and close > open
bearFVG = high < math.min(low[1], low[2]) and close < open

bullFvgGap = low - math.max(high[1], high[2])
bearFvgGap = math.min(low[1], low[2]) - high

// ============================
// BOS + CHoCH detection
// ============================
currentBullHigh = ta.highest(high, bosLookback)
currentBearLow = ta.lowest(low, bosLookback)
prevBullHigh = ta.highest(high[1], bosLookback)
prevBearLow = ta.lowest(low[1], bosLookback)

bullBOS = close > currentBullHigh and close[1] <= prevBullHigh
bearBOS = close < currentBearLow and close[1] >= prevBearLow

bullChoCH = close > currentBullHigh and close[1] < prevBullHigh and close > open
bearChoCH = close < currentBearLow and close[1] > prevBearLow and close < open

// ============================
// HH/LL detection
// ============================
lastPivotHigh = ta.pivothigh(high, pivotLeft, pivotRight)
lastPivotLow = ta.pivotlow(low, pivotLeft, pivotRight)

prevPivotHigh = ta.pivothigh(high[1], pivotLeft, pivotRight)
prevPivotLow = ta.pivotlow(low[1], pivotLeft, pivotRight)

bullHH = not na(lastPivotHigh) and not na(prevPivotHigh) and lastPivotHigh > prevPivotHigh
bearLL = not na(lastPivotLow) and not na(prevPivotLow) and lastPivotLow < prevPivotLow

// ============================
// Volume bubbles
// ============================
volAvg = ta.sma(volume, volLookback)
volBubble = volume > volAvg * volMultiplier

// ============================
// Plot signals
// ============================
plotshape(showFVG and bullFVG and bullFvgGap >= minFvgGap, title="Bull FVG", text="Bull FVG", style=shape.triangleup, location=location.belowbar, color=color.new(color.lime, 0), textcolor=color.new(color.white, 0), size=size.tiny)
plotshape(showFVG and bearFVG and bearFvgGap >= minFvgGap, title="Bear FVG", text="Bear FVG", style=shape.triangledown, location=location.abovebar, color=color.new(color.red, 0), textcolor=color.new(color.white, 0), size=size.tiny)

plotshape(showBOS and bullBOS, title="Bull BOS", text="BOS", style=shape.labelup, location=location.belowbar, color=color.new(color.green, 0), textcolor=color.new(color.white, 0), size=size.tiny)
plotshape(showBOS and bearBOS, title="Bear BOS", text="BOS", style=shape.labeldown, location=location.abovebar, color=color.new(color.maroon, 0), textcolor=color.new(color.white, 0), size=size.tiny)

plotshape(showCHoCH and bullChoCH, title="Bull CHoCH", text="CHoCH", style=shape.labelup, location=location.belowbar, color=color.new(color.teal, 0), textcolor=color.new(color.white, 0), size=size.tiny)
plotshape(showCHoCH and bearChoCH, title="Bear CHoCH", text="CHoCH", style=shape.labeldown, location=location.abovebar, color=color.new(color.orange, 0), textcolor=color.new(color.white, 0), size=size.tiny)

plotshape(showHHLL and bullHH, title="HH", text="HH", style=shape.circle, location=location.belowbar, color=color.new(color.aqua, 0), textcolor=color.new(color.black, 0), size=size.tiny)
plotshape(showHHLL and bearLL, title="LL", text="LL", style=shape.circle, location=location.abovebar, color=color.new(color.fuchsia, 0), textcolor=color.new(color.white, 0), size=size.tiny)

plotshape(showVol and volBubble, title="Volume Bubble", style=shape.circle, location=location.absolute, color=color.new(color.yellow, 25), size=size.tiny)

alertcondition(bullBOS, "Bull BOS", "Bullish BOS detected")
alertcondition(bearBOS, "Bear BOS", "Bearish BOS detected")
alertcondition(bullChoCH, "Bull CHoCH", "Bullish CHoCH detected")
alertcondition(bearChoCH, "Bear CHoCH", "Bearish CHoCH detected")
alertcondition(volBubble, "Volume Spike", "Volume spike detected")
